From cdf311f4875603e44bf65909655c17781d9e8af3 Mon Sep 17 00:00:00 2001
From: Kevin Brown <kevin@hrinnovate.org>
Date: Sat, 3 Oct 2026 13:59:44 -0500
Subject: [PATCH] Select final 20/21 kHz production profile and test ultrasonic
 WAV integration

---
 lib/protocol/d09_profile.dart      |   4 ++--
 pubspec.yaml                       |   2 +-
 test/compact_integration_test.dart |   5 +++--
 test/consumer_logic_test.dart      |   4 ++--
 test/consumer_ui_test.dart         |   2 +-
 test/fixtures/merchant-96939B.wav  | Bin 591404 -> 591404 bytes
 test/fixtures/merchant-ABC123.wav  | Bin 591404 -> 591404 bytes
 test/merchant_wav_test.dart        |  13 ++++++-------
 test/product_polish_test.dart      |   2 +-
 test/startup_integration_test.dart |   6 +++---
 10 files changed, 19 insertions(+), 19 deletions(-)

diff --git a/lib/protocol/d09_profile.dart b/lib/protocol/d09_profile.dart
index 2955e76..26c696d 100644
--- a/lib/protocol/d09_profile.dart
+++ b/lib/protocol/d09_profile.dart
@@ -1,7 +1,7 @@
 // Generated from backend/app/d09_profile.json; run tool/sync_d09_profile.py.
 abstract final class D09Profile {
   static const int sampleRate = 48000;
-  static const double zeroHz = 4000;
-  static const double oneHz = 5000;
+  static const double zeroHz = 20000;
+  static const double oneHz = 21000;
   static const int symbolMs = 40;
 }
diff --git a/pubspec.yaml b/pubspec.yaml
index 5c66ff3..baa9df3 100644
--- a/pubspec.yaml
+++ b/pubspec.yaml
@@ -16,7 +16,7 @@ publish_to: 'none' # Remove this line if you wish to publish to pub.dev
 # https://developer.apple.com/library/archive/documentation/General/Reference/InfoPlistKeyReference/Articles/CoreFoundationKeys.html
 # In Windows, build-name is used as the major, minor, and patch parts
 # of the product and file versions while build-number is used as the build suffix.
-version: 1.0.5+16
+version: 1.0.6+17
 
 environment:
   sdk: ^3.8.0
diff --git a/test/compact_integration_test.dart b/test/compact_integration_test.dart
index 07a1d8d..ce0dcd2 100644
--- a/test/compact_integration_test.dart
+++ b/test/compact_integration_test.dart
@@ -93,9 +93,10 @@ void main() {
     addTearDown(tester.view.resetDevicePixelRatio);
     final capture = TestCapture();
     final controller = BeaconController(capture, LocalContentRepository());
-    expect(controller.config.zeroHz, 4000);
-    expect(controller.config.oneHz, 5000);
+    expect(controller.config.zeroHz, 20000);
+    expect(controller.config.oneHz, 21000);
     expect(controller.config.symbolMs, 40);
+    await controller.configure(audible); // Explicit legacy audible diagnostic fixture.
     await controller.start();
     capture.stream.add(
       pcmSamples(readPcm()).sublist(0, 4800 + 48 * 1920 + 4800),
diff --git a/test/consumer_logic_test.dart b/test/consumer_logic_test.dart
index 7ee3a6f..b6b9ee6 100644
--- a/test/consumer_logic_test.dart
+++ b/test/consumer_logic_test.dart
@@ -83,7 +83,7 @@ void main() {
         device: device,
       );
       await controller.start();
-      capture.stream.add(pcmSamples(readPcm()));
+      capture.stream.add(pcmSamples(readPcm('test/fixtures/merchant-ABC123.wav')));
       await flush();
       expect(controller.audio.detector.diagnostics.acceptedFrames, 3);
       expect(controller.campaigns.length, 1);
@@ -143,7 +143,7 @@ void main() {
       await controller.start();
       final detector = controller.audio.detector;
       capture.stream.add(
-        pcmSamples(readPcm()).sublist(0, 4800 + 48 * 1920 + 4800),
+        pcmSamples(readPcm('test/fixtures/merchant-ABC123.wav')).sublist(0, 4800 + 48 * 1920 + 4800),
       );
       await flush();
       expect(controller.audio.error, isNotNull);
diff --git a/test/consumer_ui_test.dart b/test/consumer_ui_test.dart
index d57e3d9..38233d3 100644
--- a/test/consumer_ui_test.dart
+++ b/test/consumer_ui_test.dart
@@ -126,7 +126,7 @@ void main() {
       await tester.pumpAndSettle();
       await snapshot(tester, 'listening');
       capture.stream.add(
-        pcmSamples(readPcm()).sublist(0, 4800 + 48 * 1920 + 4800),
+        pcmSamples(readPcm('test/fixtures/merchant-ABC123.wav')).sublist(0, 4800 + 48 * 1920 + 4800),
       );
       await tester.pumpAndSettle();
       expect(controller.detectedOffers.length, 4);
