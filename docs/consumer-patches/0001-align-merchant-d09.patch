diff --git a/test/merchant_wav_test.dart b/test/merchant_wav_test.dart
new file mode 100644
index 0000000..3bc7122
--- /dev/null
+++ b/test/merchant_wav_test.dart
@@ -0,0 +1,32 @@
+import 'dart:math';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:acoustic_beacon/application/beacon_controller.dart';
+import 'package:acoustic_beacon/data/content.dart';
+import 'package:acoustic_beacon/dsp/detector.dart';
+import 'package:acoustic_beacon/protocol/beacon_protocol.dart';
+import 'controller_test.dart' show TestCapture;
+import 'compact_test.dart' show readPcm, pcmSamples;
+
+void main() {
+ for (final id in ['ABC123', '96939B']) {
+  test('backend WAV $id decodes using out-of-box production configuration', () {
+   final controller=BeaconController(TestCapture(),LocalContentRepository());
+   final samples=pcmSamples(readPcm('test/fixtures/merchant-$id.wav'));
+   final ids=<String>[];
+   final detector=BeaconDetector(controller.config,(id,_)=>ids.add(id));
+   detector.add(List.filled(137,0.0));
+   for(var i=0;i<samples.length;i+=997){detector.add(samples.sublist(i,min(i+997,samples.length)));}
+   expect(ids,isNotEmpty);
+   expect(ids.toSet(),{'0x$id'});
+   expect(detector.diagnostics.checksum,'PASS');
+   controller.dispose();
+  });
+  test('backend WAV $id control with audible D09 configuration', () {
+   final samples=pcmSamples(readPcm('test/fixtures/merchant-$id.wav'));
+   final ids=<String>[];
+   final detector=BeaconDetector(const BeaconConfig(zeroHz:4000,oneHz:5000),(id,_)=>ids.add(id));
+   detector.add(samples);
+   expect(ids.toSet(),{'0x$id'});
+  });
+ }
+}
