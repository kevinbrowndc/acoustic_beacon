From 055f7a109eb6489b4d14c0af3016d82df8f0f6fb Mon Sep 17 00:00:00 2001
From: Kevin Brown <kevin@hrinnovate.org>
Date: Sat, 3 Oct 2026 12:47:13 -0500
Subject: [PATCH] Align consumer defaults with merchant D09 audio and replay
 backend WAVs

---
 lib/application/beacon_controller.dart |   2 +-
 lib/protocol/beacon_protocol.dart      |   9 +++----
 lib/protocol/d09_profile.dart          |   7 ++++++
 pubspec.yaml                           |   2 +-
 test/fixtures/merchant-96939B.wav      | Bin 0 -> 591404 bytes
 test/fixtures/merchant-ABC123.wav      | Bin 0 -> 591404 bytes
 test/merchant_wav_test.dart            |  32 +++++++++++++++++++++++++
 7 files changed, 46 insertions(+), 6 deletions(-)
 create mode 100644 lib/protocol/d09_profile.dart
 create mode 100644 test/fixtures/merchant-96939B.wav
 create mode 100644 test/fixtures/merchant-ABC123.wav
 create mode 100644 test/merchant_wav_test.dart

diff --git a/lib/application/beacon_controller.dart b/lib/application/beacon_controller.dart
index 64a7f02..9e7c6ed 100644
--- a/lib/application/beacon_controller.dart
+++ b/lib/application/beacon_controller.dart
@@ -18,7 +18,7 @@ enum ListeningState {
 class BeaconController extends ChangeNotifier {
   final PcmCapture capture;
   final ContentRepository repository;
-  BeaconConfig config = const BeaconConfig(zeroHz: 4000, oneHz: 5000);
+  BeaconConfig config = const BeaconConfig();
   late BeaconDetector detector;
   ListeningState state = ListeningState.idle;
   BeaconContent? content;
diff --git a/lib/protocol/beacon_protocol.dart b/lib/protocol/beacon_protocol.dart
index e1bf085..28385d4 100644
--- a/lib/protocol/beacon_protocol.dart
+++ b/lib/protocol/beacon_protocol.dart
@@ -1,4 +1,5 @@
 import 'dart:math';
+import 'd09_profile.dart';
 import 'dart:typed_data';
 
 class BeaconConfig {
@@ -6,12 +7,12 @@ class BeaconConfig {
   final double zeroHz, oneHz, threshold, confidence;
   final int symbolMs, repeats;
   const BeaconConfig({
-    this.sampleRate = 48000,
-    this.zeroHz = 20000,
-    this.oneHz = 21000,
+    this.sampleRate = D09Profile.sampleRate,
+    this.zeroHz = D09Profile.zeroHz,
+    this.oneHz = D09Profile.oneHz,
     this.threshold = 0.008,
     this.confidence = 0.75,
-    this.symbolMs = 40,
+    this.symbolMs = D09Profile.symbolMs,
     this.repeats = 1,
   });
   void validate() {
diff --git a/lib/protocol/d09_profile.dart b/lib/protocol/d09_profile.dart
new file mode 100644
index 0000000..2955e76
--- /dev/null
+++ b/lib/protocol/d09_profile.dart
@@ -0,0 +1,7 @@
+// Generated from backend/app/d09_profile.json; run tool/sync_d09_profile.py.
+abstract final class D09Profile {
+  static const int sampleRate = 48000;
+  static const double zeroHz = 4000;
+  static const double oneHz = 5000;
+  static const int symbolMs = 40;
+}
diff --git a/pubspec.yaml b/pubspec.yaml
index faf2684..5c66ff3 100644
--- a/pubspec.yaml
+++ b/pubspec.yaml
@@ -16,7 +16,7 @@ publish_to: 'none' # Remove this line if you wish to publish to pub.dev
 # https://developer.apple.com/library/archive/documentation/General/Reference/InfoPlistKeyReference/Articles/CoreFoundationKeys.html
 # In Windows, build-name is used as the major, minor, and patch parts
 # of the product and file versions while build-number is used as the build suffix.
-version: 1.0.4+15
+version: 1.0.5+16
 
 environment:
   sdk: ^3.8.0
