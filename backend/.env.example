AB_ENVIRONMENT=development
AB_DATABASE_URL=postgresql+psycopg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/CHANGE_ME_DATABASE
# For a no-service local demo, use sqlite:///./beacon.db instead.

# Native mobile clients do not need CORS. For a web client, use explicit HTTPS origins.
AB_CORS_ORIGINS=[]
# Explicit opt-in for a public, clearly labeled non-redeemable test campaign.
AB_PROVISION_TEST_BEACON=false
